# Read `man 5 sway` for a complete reference.

### Variables#
# Logo key
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Recommends: foot
set $term foot
# Recommends: rofi
set $menu rofi -show drun

# include sway-systemd config files
include /etc/sway/config.d/10-systemd-cgroups.conf
include /etc/sway/config.d/10-systemd-session.conf
# comment this and manually set kb config if issues with kb layout are detected
include /etc/sway/config.d/95-system-keyboard-config.conf
include /etc/sway/config.d/95-xdg-desktop-autostart.conf
# include all remaining config files in config.d
include "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf
