{
    "layer": "bottom", // Waybar at top layer
    "position": "top",
    "height": 25, // Waybar height (to be removed for auto height)
    "output": "eDP-1",
    // Choose the order of the modules
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["idle_inhibitor", "cpu", "memory", "pulseaudio", "battery", "tray"],
    // Modules configuration
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format-icons": {
    //         "1": "",
    //         "2": "",
    //         "3": "",
    //         "4": "",
    //         "5": "",
          "urgent": "",
          "focused": "",
        }
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "tray": {
        "min-length": 5,
        "spacing": 3
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "clock": {
        "format": "{:%H:%M}",
	"format-alt": "{:%a, %d %b %g}",
	"tooltip-format": "{:%a, %d %b}",
        "tooltip": true
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false,
        "interval": 5
	//"on-click": "foot htop"
    },
    "memory": {
        "format": "{}% ",
        "tooltip": false
        //"on-click": "foot htop"
    },
    "battery": {
        "bat": "BAT0",
        "states": {
            "good": 85,
            "warning": 25,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "",
        "format-alt": "{time} {icon}",
        "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "{icon} {format_source}",
        "format-muted": "",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": " ",
            "headset": " ",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [" ", " ", " "]
        },
        "on-click": "pavucontrol"
    }
}
