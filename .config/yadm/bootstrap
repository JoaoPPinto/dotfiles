#!/usr/bin/env bash
# ~/.config/yadm/bootstrap
#
# Runs every executable file in bootstrap.d/ in sorted order.
# A step is disabled by clearing its executable bit:
#
#     chmod -x ~/.config/yadm/bootstrap.d/30-packages-desktop
#
# every step should be idempotent.
set -euo pipefail

bootstrap_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

export BOOTSTRAP_LIB="${bootstrap_dir}/bootstrap.lib.sh"
[[ -r "$BOOTSTRAP_LIB" ]] || {
    printf 'ERROR: %s\n' "library not found: ${BOOTSTRAP_LIB}" >&2
    exit 1
}
. "$BOOTSTRAP_LIB"

steps_dir="${bootstrap_dir}/bootstrap.d"
[[ -d "$steps_dir" ]] || abort "no steps directory: ${steps_dir}"

detect_distro
detect_classes
export BOOTSTRAP_DISTRO BOOTSTRAP_DISTRO_FAMILY BOOTSTRAP_HOSTNAME BOOTSTRAP_CLASSES

require_sudo

shopt -s nullglob
steps=("$steps_dir"/*)
shopt -u nullglob
(( ${#steps[@]} )) || abort "no steps found in ${steps_dir}"

for step in "${steps[@]}"; do
    name="$(basename "$step")"

    [[ -f "$step" ]] || continue
    if [[ ! -x "$step" ]]; then
        log "Skipping ${name} (disabled)"
        continue
    fi

    log "Running ${name}"
    "$step" || abort "step failed: ${name}"
done

log "Bootstrap finished"
